{
  "info": {
    "name": "Smart City Platform - OAuth 2.0 & API Gateway",
    "description": "API collection for testing OAuth 2.0 Authorization Server and API Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/health",
              "host": [
                "{{gateway_url}}"
              ],
              "path": ["health"]
            },
            "description": "Check gateway and all downstream services health"
          }
        },
        {
          "name": "Auth Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_service_url}}/health",
              "host": [
                "{{auth_service_url}}"
              ],
              "path": ["health"]
            },
            "description": "Check OAuth server health"
          }
        },
        {
          "name": "Gateway Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/metrics",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "metrics"
              ]
            },
            "description": "Prometheus Metrics for API Gateway"
          }
        }
      ]
    },
    {
      "name": "User Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/register",
              "host": [
                "{{gateway_url}}"
              ],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new user account"
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": ["api", "auth", "login"]
            },
            "description": "Login user and get tokens"
          }
        },
        {
          "name": "Social Login (Mock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"google\",\n  \"token\": \"access-token\",\n  \"email\": \"socialuser@gmail.com\",\n  \"name\": \"Social User\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/social-login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": ["api", "auth", "social-login"]
            },
            "description": "Mock endpoint for Social Login (Google, Facebook, Github)"
          }
        }
      ]
    },
    {
      "name": "OAuth 2.0 - Token Endpoint",
      "item": [
        {
          "name": "Password Grant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"password\",\n  \"client_id\": \"test-client\",\n  \"client_secret\": \"test-secret\",\n  \"username\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/oauth/token",
              "host": [
                "{{gateway_url}}"
              ],
              "path": ["oauth", "token"]
            },
            "description": "Get access token using password grant (user login)"
          }
        },
        {
          "name": "Client Credentials Grant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"client_credentials\",\n  \"client_id\": \"test-client\",\n  \"client_secret\": \"test-secret\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/oauth/token",
              "host": [
                "{{gateway_url}}"
              ],
              "path": ["oauth", "token"]
            },
            "description": "Get access token using client credentials grant (service-to-service)"
          }
        },
        {
          "name": "Refresh Token Grant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"refresh_token\",\n  \"client_id\": \"test-client\",\n  \"client_secret\": \"test-secret\",\n  \"refresh_token\": \"{refresh_token}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/oauth/token",
              "host": [
                "{{gateway_url}}"
              ],
              "path": ["oauth", "token"]
            },
            "description": "Refresh access token using refresh token"
          }
        }
      ]
    },
    {
      "name": "OAuth 2.0 - Token Management",
      "item": [
        {
          "name": "Introspect Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-gateway-secret",
                "value": "smartcity_internal_secret"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{access_token}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/oauth/introspect",
              "host": [
                "{{gateway_url}}"
              ],
              "path": ["oauth", "introspect"]
            },
            "description": "Validate token and get token metadata"
          }
        },
        {
          "name": "Revoke Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{access_token}}\",\n  \"token_type_hint\": \"access_token\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/oauth/revoke",
              "host": [
                "{{gateway_url}}"
              ],
              "path": ["oauth", "revoke"]
            },
            "description": "Revoke access token"
          }
        },
        {
          "name": "Revoke Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{refresh_token}}\",\n  \"token_type_hint\": \"refresh_token\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/oauth/revoke",
              "host": [
                "{{gateway_url}}"
              ],
              "path": ["oauth", "revoke"]
            },
            "description": "Revoke access token"
          }
        }
      ]
    },
    {
      "name": "Protected Routes",
      "item": [
        {
          "name": "Get Airquality Data (No Token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/airquality/data",
              "host": [
                "{{gateway_url}}"
              ],
              "path": ["api", "airquality", "data"]
            },
            "description": "Should return 401 Unauthorized"
          }
        },
        {
          "name": "Get Airquality Data (With Token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/airquality/data",
              "host": [
                "{{gateway_url}}"
              ],
              "path": ["api", "airquality", "data"]
            },
            "description": "Should return 200 OK via Proxy"
          }
        }
      ]
    },
    {
      "name": "ML Service",
      "item": [
        {
          "name": "Get Model Feature Importance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/ml/model/feature-importance",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "ml",
                "model",
                "feature-importance"
              ]
            },
            "description": "Mengambil bobot fitur (feature importance) dari model-model yang telah dilatih. Endpoint ini memerlukan otentikasi JWT."
          },
          "response": []
        },
        {
          "name": "Predict AQI in Batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"requests\": [\n        {\n            \"pm25\": 55,\n            \"pm10\": 75,\n            \"no2\": 22,\n            \"co\": 0.9,\n            \"o3\": 34,\n            \"temperature\": 31,\n            \"humidity\": 78\n        },\n        {\n            \"pm25\": 12,\n            \"pm10\": 20,\n            \"no2\": 10,\n            \"co\": 0.4,\n            \"o3\": 45,\n            \"temperature\": 29,\n            \"humidity\": 80\n        },\n        {\n            \"pm25\": 160,\n            \"pm10\": 180,\n            \"no2\": 40,\n            \"co\": 1.5,\n            \"o3\": 25,\n            \"temperature\": 33,\n            \"humidity\": 72\n        }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway_url}}/api/ml/predict/batch",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "ml",
                "predict",
                "batch"
              ]
            },
            "description": "Melakukan prediksi AQI untuk sekumpulan data (batch) dalam satu panggilan API. Ini jauh lebih efisien daripada memanggil endpoint prediksi satu per satu."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Invalid Grant Type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"invalid_grant\",\n  \"username\": \"user@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/oauth/token",
              "host": [
                "{{gateway_url}}"
              ],
              "path": ["oauth", "token"]
            },
            "description": "Request token with unsupported grant type (should get 400)"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "auth_service_url",
      "value": "http://localhost:3002"
    },
    {
      "key": "access_token",
      "value": "",
      "description": "Access token obtained from /oauth/token endpoint"
    },
    {
      "key": "refresh_token",
      "value": "",
      "description": "Refresh token obtained from /oauth/token endpoint"
    }
  ]
}
